{
    "version": 2,
    "buildCommand": "pip install -r requirements.txt",
    "builds": [
        {
            "src": "wsgi.py",
            "use": "@vercel/python@3.1.31",
            "config": {
                "maxLambdaSize": "15mb",
                "runtime": "python3.9"
            }
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/static/$1"
        },
        {
            "src": "/(.*)",
            "dest": "wsgi.py"
        }
    ],
    "env": {
        "FLASK_ENV": "production",
        "FLASK_APP": "app",
        "PYTHONPATH": ".",
        "PIP_TARGET": ".pip"
    }
}